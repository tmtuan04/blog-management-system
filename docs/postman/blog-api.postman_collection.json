{
  "info": {
    "_postman_id": "2b9a7c1e-blog-api-collection",
    "name": "Blog Management System API",
    "description": "Phase 3. Chạy trên dữ liệu vừa seed:\n\npostman collection run docs/postman/blog-api.postman_collection.json -e docs/postman/local.postman_environment.json\n\nFolder 00 - Auth chạy đầu tiên và lưu token vào biến môi trường. Mỗi người chỉ sửa folder của module mình (phase 3 doc mục 6.3).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mọi request gửi ngôn ngữ đang chọn",
          "pm.request.headers.upsert({ key: 'Accept-Language', value: pm.environment.get('lang') || 'vi' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Format chung requirements 6.4",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "if (contentType.includes('application/json')) {",
          "  pm.test('Response có trường success', () => {",
          "    pm.expect(pm.response.json()).to.have.property('success');",
          "  });",
          "}"
        ]
      }
    }
  ],
