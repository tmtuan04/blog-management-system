      "item": [
        {
          "name": "UC01 - Đăng ký",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email mới mỗi lần chạy",
                  "pm.environment.set('regEmail', `postman-${Date.now()}@test.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 và success = true', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test('Role user', () => pm.expect(pm.response.json().data.role).to.eql('user'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người dùng Postman\",\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"confirmPassword\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
