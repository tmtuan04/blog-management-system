                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "const data = pm.response.json().data;",
                  "pm.test('Role blog_owner', () => pm.expect(data.user.role).to.eql('blog_owner'));",
                  "// Token mặc định của collection là token Blog Owner",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);",
                  "pm.environment.set('ownerAccessToken', data.accessToken);"
                ]
