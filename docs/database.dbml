// Blog Management System - ERD
// MySQL 8, charset utf8mb4 / utf8mb4_unicode_ci
// Docs: https://dbml.dbdiagram.io/docs

Project blog_management_system {
  database_type: 'MySQL'
  Note: '''
    Blog đa ngôn ngữ (xem docs/requirements.md).
    - Mỗi post có 1 ngôn ngữ gốc và có thể dịch ra nhiều ngôn ngữ khác (D3): phần dùng chung ở posts, phần theo ngôn ngữ ở post_translations.
    - Category dùng chung, chỉ dịch tên (D4).
    - Refresh token, token reset mật khẩu, rate limit, đếm lượt xem lưu trong Redis, không có bảng.
  '''
}

// ============ Enums ============

Enum oauth_provider {
  google
  github
}

Enum post_status {
  draft
  published
  archived
}

// ============ Users & Auth ============

Table roles {
  id int [pk, increment]
  code varchar(30) [not null, unique, note: 'user, blog_owner, super_admin. Code dùng trong guard phân quyền, không đổi được']
  name varchar(100) [not null, note: 'Tên hiển thị']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Danh sách cố định, chỉ tạo bằng seeder, không có màn hình quản lý. Mỗi user có đúng 1 role.'
}

Table users {
  id bigint [pk, increment]
  full_name varchar(150) [not null, note: '2-150 ký tự']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [null, note: 'NULL với tài khoản tạo qua OAuth chưa đặt mật khẩu']
  avatar varchar(255) [null, note: 'Đường dẫn file trong uploads/']
  role_id int [not null, note: 'Tài khoản mới (đăng ký, OAuth) gán role code = user, lấy id ở service']
  is_active boolean [not null, default: true, note: 'Khóa tài khoản = false. Không xóa cứng (D8)']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table oauth_accounts {
  id bigint [pk, increment]
  user_id bigint [not null]
  provider oauth_provider [not null]
  provider_user_id varchar(255) [not null, note: 'ID của user bên provider']
  provider_email varchar(255) [null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (provider, provider_user_id) [unique]
    (user_id, provider) [unique, note: 'Mỗi user liên kết tối đa 1 tài khoản / provider']
  }
}

// ============ Languages ============

Table languages {
  id int [pk, increment]
  code varchar(10) [not null, unique, note: 'ISO 639-1: vi, en...']
  name varchar(100) [not null, note: 'Tên hiển thị']
  is_default boolean [not null, default: false, note: 'Luôn đúng 1 dòng = true (đảm bảo ở service, trong transaction)']
  is_active boolean [not null, default: true, note: 'Không được tắt ngôn ngữ mặc định']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

// ============ Categories ============

Table categories {
  id int [pk, increment]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Không xóa được khi còn bài viết (FK posts.category_id RESTRICT)'
}

Table category_translations {
  id int [pk, increment]
  category_id int [not null]
  language_id int [not null]
  name varchar(150) [not null]
  slug varchar(180) [not null, note: 'Sinh từ name, bỏ dấu']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (category_id, language_id) [unique]
    (language_id, slug) [unique, note: 'Slug duy nhất trong cùng ngôn ngữ']
  }

  Note: 'Bắt buộc có bản dịch của ngôn ngữ mặc định. Thiếu ngôn ngữ nào thì fallback về mặc định.'
}

// ============ Posts ============

Table posts {
  id bigint [pk, increment]
  user_id bigint [not null, note: 'Tác giả']
  language_id int [not null, note: 'Ngôn ngữ gốc. Chọn khi tạo bài, không đổi được']
  category_id int [not null, note: 'Dùng chung cho mọi bản dịch']
  thumbnail varchar(255) [null, note: 'Đường dẫn file trong uploads/. Dùng chung cho mọi bản dịch']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id [note: 'Danh sách bài của owner UC13']
    category_id [note: 'Bài theo danh mục UC07']
  }

  Note: 'Phần dùng chung của bài viết. Nội dung theo từng ngôn ngữ nằm ở post_translations.'
}

Table post_translations {
  id bigint [pk, increment]
  post_id bigint [not null]
  language_id int [not null]
  title varchar(255) [not null, note: '5-255 ký tự']
  slug varchar(280) [not null]
  excerpt varchar(500) [null, note: 'Tóm tắt']
  content mediumtext [not null, note: 'HTML đã lọc XSS']
  status post_status [not null, default: 'draft', note: 'Trạng thái riêng của từng bản dịch']
  view_count int [not null, default: 0, note: 'UNSIGNED. Đếm riêng theo từng bản dịch']
  published_at datetime [null, note: 'Ghi lần đầu bản dịch chuyển sang published']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (post_id, language_id) [unique, note: 'Mỗi bài có tối đa 1 bản dịch / ngôn ngữ']
    (language_id, slug) [unique, note: 'Slug duy nhất trong cùng ngôn ngữ, trùng thì thêm -2, -3...']
    (language_id, status, published_at) [note: 'Trang chủ UC05, bài theo danh mục UC07 (JOIN posts)']
  }

  Note: '''
    Bản dịch có language_id = posts.language_id là bản gốc: bắt buộc có, tạo cùng lúc với bài, không xóa riêng được (kiểm tra ở service).
    Bản dịch của ngôn ngữ khác thêm/xóa tùy ý. Không fallback: ngôn ngữ nào chưa có bản dịch published thì bài không hiện ở ngôn ngữ đó.
    FULLTEXT index (tạo trong migration bằng raw SQL, DBML không hỗ trợ):
    CREATE FULLTEXT INDEX ft_post_translations_search ON post_translations(title, excerpt, content) WITH PARSER ngram;
  '''
}

// ============ Comments ============

Table comments {
  id bigint [pk, increment]
  post_translation_id bigint [not null, note: 'Bình luận gắn với từng bản dịch (mỗi ngôn ngữ có luồng bình luận riêng)']
  user_id bigint [not null]
  parent_id bigint [null, note: 'NULL = bình luận gốc. Chỉ 1 cấp: parent phải có parent_id = NULL và cùng post_translation_id (kiểm tra ở service)']
  content varchar(1000) [not null, note: 'Văn bản thuần, 1-1000 ký tự']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (post_translation_id, parent_id, created_at)
    user_id
  }
}

// ============ UI translations ============

Table ui_translations {
  id int [pk, increment]
  language_id int [not null]
  key varchar(150) [not null, note: 'Ví dụ menu.home']
  value text [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (language_id, key) [unique]
  }

  Note: 'Thêm ngôn ngữ mới thì copy toàn bộ key từ ngôn ngữ mặc định.'
}

// ============ Static pages ============

Table pages {
  id int [pk, increment]
  key varchar(50) [not null, unique, note: 'about, contact, privacy. Chỉ tạo bằng seeder, không đổi được']
  is_visible boolean [not null, default: true, note: 'Áp dụng cho mọi ngôn ngữ']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table page_translations {
  id int [pk, increment]
  page_id int [not null]
  language_id int [not null]
  title varchar(255) [not null, note: '2-255 ký tự']
  content mediumtext [not null, note: 'HTML đã lọc XSS']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (page_id, language_id) [unique]
  }

  Note: 'Ngôn ngữ không mặc định để trống cả title và content thì không lưu dòng (fallback về mặc định).'
}

// ============ Relationships ============

Ref user_role: users.role_id > roles.id [delete: restrict] // không xóa role đang có user
Ref oauth_user: oauth_accounts.user_id > users.id [delete: cascade]

Ref post_author: posts.user_id > users.id [delete: restrict]
Ref post_language: posts.language_id > languages.id [delete: restrict] // không xóa ngôn ngữ gốc của bài
Ref post_category: posts.category_id > categories.id [delete: restrict] // không xóa danh mục đang có bài

Ref post_tr_post: post_translations.post_id > posts.id [delete: cascade] // xóa bài thì xóa mọi bản dịch
Ref post_tr_language: post_translations.language_id > languages.id [delete: restrict] // không xóa ngôn ngữ đang có bản dịch bài viết

Ref category_tr_category: category_translations.category_id > categories.id [delete: cascade]
Ref category_tr_language: category_translations.language_id > languages.id [delete: cascade]

Ref comment_post_tr: comments.post_translation_id > post_translations.id [delete: cascade] // xóa bản dịch (hoặc cả bài) thì xóa bình luận
Ref comment_user: comments.user_id > users.id [delete: restrict]
Ref comment_parent: comments.parent_id > comments.id [delete: cascade] // xóa cha thì xóa trả lời

Ref ui_tr_language: ui_translations.language_id > languages.id [delete: cascade]

Ref page_tr_page: page_translations.page_id > pages.id [delete: cascade]
Ref page_tr_language: page_translations.language_id > languages.id [delete: cascade]

// ============ Sample records ============

Records languages(id, code, name, is_default, is_active) {
  1, 'vi', 'Tiếng Việt', true, true
  2, 'en', 'English', false, true
}

