# Copy thành .env rồi điền giá trị. Không commit .env.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# MySQL trong docker-compose (đổi DB_PORT nếu đã đặt MYSQL_HOST_PORT)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog_dev
DB_USER=blog
DB_PASSWORD=blog
# Database cho npm run test:e2e (mặc định blog_test)
DB_TEST_NAME=blog_test

# Redis trong docker-compose (đổi REDIS_PORT nếu đã đặt REDIS_HOST_PORT)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis db cho npm run test:e2e (mặc định 1)
REDIS_TEST_DB=1

# Chuỗi ngẫu nhiên, tối thiểu 16 ký tự, 2 secret khác nhau
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# SMTP: dev dùng Ethereal (https://ethereal.email) hoặc Mailtrap
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Blog <no-reply@blog.local>"

# OAuth (UC20, việc A6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Thư mục lưu ảnh (tương đối với backend/), tối đa 2MB
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=2097152
